# Virtual environments (we don't want to upload huge library folders)
venv/
env/
.env

# Compiled Python files (generated automatically)
__pycache__/
*.pyc
*.pyo
*.pyd

# Local logs and databases
*.log
*.sqlite3

# Local VS Code configuration files
.vscode/

# Hidden operating system files
Thumbs.db
.DS_Store

# --- Medical Data Privacy ---
# Ignore all patient data files in the exports directory to prevent accidental upload
exports/*.csv
exports/*.xlsx
exports/*.json

# Make sure we still track the exports folder itself using the .gitkeep file
!exports/.gitkeep